# ==============================================================================
# Ethical Crawler Configuration
# ==============================================================================

# 1. Ethical Bot Identification (Rule 3)
CRAWLER_BOT_NAME=EthicalCrawlerBot
CRAWLER_BOT_VERSION=1.0.0
CRAWLER_BOT_URL=https://github.com/example/ethical-crawler
CRAWLER_BOT_EMAIL=crawler-contact@example.com

# 2. Politeness & Rate Limiting (Rule 2)
# Minimum delay between requests to the same domain (in seconds)
CRAWLER_DEFAULT_DELAY=2.0
# Global concurrency limit (number of simultaneous requests across all domains)
CRAWLER_MAX_CONCURRENCY=5
# Max depth for recursive link crawling
CRAWLER_MAX_DEPTH=3
# Max pages to crawl per job
CRAWLER_MAX_PAGES=50
# Request timeout in seconds
CRAWLER_REQUEST_TIMEOUT=15.0

# 3. Robots.txt Policy (Rule 1)
CRAWLER_RESPECT_ROBOTS_TXT=true
# Cache TTL for robots.txt in seconds (default 1 hour)
CRAWLER_ROBOTS_CACHE_TTL=3600

# 4. Sitemap Discovery (Rule 4)
CRAWLER_AUTO_DISCOVER_SITEMAP=true

# 5. Browser Automation (Dynamic SPAs)
CRAWLER_ENABLE_BROWSER_FALLBACK=true
CRAWLER_HEADLESS_BROWSER=true

# 6. AI-Native LLM Extraction (OpenAI / NVIDIA NIM API)
# NVIDIA NIM API Base URL: https://integrate.api.nvidia.com/v1
# OpenAI API Base URL: https://api.openai.com/v1
CRAWLER_AI_BASE_URL=https://integrate.api.nvidia.com/v1
CRAWLER_AI_API_KEY=
# Example models:
# NVIDIA: meta/llama-3.3-70b-instruct, mistralai/mixtral-8x22b-instruct
# OpenAI: gpt-4o-mini, gpt-4o
CRAWLER_AI_MODEL=meta/llama-3.2-11b-vision-instruct

# 7. Web Server
CRAWLER_API_HOST=0.0.0.0
CRAWLER_API_PORT=8000

# 8. Vector Database & Smart Cache (ChromaDB)
CRAWLER_CHROMA_DIR=data/chroma
CRAWLER_ENABLE_CACHE=true
CRAWLER_CACHE_TTL_DAYS=7
CRAWLER_CHROMA_COLLECTION=crawled_knowledge


